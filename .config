# --- 平台与机型锁定 (只保留红米 AX6000) ---
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y
# 其他所有 CONFIG_TARGET_DEVICE_... 全部设为 n 或删除

CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_AFALG_UPDATE_CTR_IV=y

# --- 优化：精简无 USB 环境下的磁盘识别工具 ---
# CONFIG_BUSYBOX_CONFIG_BLKID is not set
# CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE is not set
# CONFIG_BUSYBOX_CONFIG_VOLUMEID is not set

# --- 优化：内存与内核特性 (为 ZRAM 和多拨打底) ---
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_KERNEL_NET_CLS_CGROUP=y

# 建议开启：增强内存交换管理 (配合 ZRAM 提升稳定性)
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_MEMCG_SWAP=y
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=y

# 移除调试与限制项 (保持系统轻量)
# CONFIG_GDB is not set
# CONFIG_KERNEL_BLK_DEV_THROTTLING is not set
# CONFIG_KERNEL_CFS_BANDWIDTH is not set

#######################################################################
#                 KMODS 优化整合版 (针对红米 AX6000)                  #
#######################################################################

# --- [ 核心加速与网络特性 ] ---
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-inet-diag=y

# --- [ 极致游戏加速：调度与队列 ] ---
CONFIG_PACKAGE_kmod-sched-core=y
# 建议补齐 CAKE 队列，对小包游戏数据极其友好
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-fq-pie=y

# --- [ 虚拟多拨支持：必须补全 ] ---
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y

# --- [ 加密加速：为加速插件打底 ] ---
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-ccm=y
CONFIG_PACKAGE_kmod-crypto-cmac=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-crypto-ctr=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-gf128=y
CONFIG_PACKAGE_kmod-crypto-ghash=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y

# --- [ 防火墙与转发兼容层 ] ---
CONFIG_PACKAGE_kmod-ebtables=y
CONFIG_PACKAGE_kmod-ebtables-ipv4=y
CONFIG_PACKAGE_kmod-ebtables-ipv6=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_kmod-ipt-filter=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
CONFIG_PACKAGE_kmod-ipt-iprange=y
CONFIG_PACKAGE_kmod-ipt-nat-extra=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# --- [ 内存优化 ] ---
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y

# --- [ 极致瘦身：移除无 USB 冗余 (原配置中建议改为 n) ] ---
# CONFIG_PACKAGE_kmod-ata-core is not set
# CONFIG_PACKAGE_kmod-scsi-core is not set
# CONFIG_PACKAGE_kmod-fs-autofs4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-nls-cp437 is not set
# CONFIG_PACKAGE_kmod-nls-iso8859-1 is not set

# --- [ 硬件支持 ] ---
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_kmod-leds-ws2812b=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-utf8=y

#######################################################################
#            WIFI OPTIONS 优化版 (MTK 7986 闭源驱动)                  #
#######################################################################

# --- [ 核心加速：必须保持 y ] ---
CONFIG_MTK_WARP_V2=y
CONFIG_WED_HW_RRO_SUPPORT=y
CONFIG_MTK_WHNAT_SUPPORT=m
CONFIG_MTK_FAST_NAT_SUPPORT=y
CONFIG_MTK_CHIP_MT7986=y
CONFIG_MTK_WIFI_SKU_TYPE="AX6000"

# --- [ WiFi 6 特性补强 ] ---
CONFIG_MTK_DOT11_HE_AX=y
CONFIG_MTK_MUMIMO_SUPPORT=y
CONFIG_MTK_MU_RA_SUPPORT=y
CONFIG_MTK_TXBF_SUPPORT=y
CONFIG_MTK_TWT_SUPPORT=y
CONFIG_MTK_G_BAND_256QAM_SUPPORT=y

# --- [ 漫游与稳定性优化 ] ---
CONFIG_MTK_DOT11K_RRM_SUPPORT=y
CONFIG_MTK_DOT11R_FT_SUPPORT=y
CONFIG_MTK_DOT11V_WNM_SUPPORT=y
CONFIG_MTK_WNM_SUPPORT=y
CONFIG_MTK_SMART_CARRIER_SENSE_SUPPORT=y

# --- [ 游戏与多设备优化 ] ---
CONFIG_MTK_SCS_FW_OFFLOAD=y
CONFIG_MTK_IGMP_SNOOP_SUPPORT=y
CONFIG_MTK_MBSS_DTIM_SUPPORT=y

# --- [ 驱动版本与路径 (保持你原有的最新版) ] ---
CONFIG_MTK_MT_WIFI_DRIVER_VERSION_7673=y
CONFIG_MTK_MT_WIFI_FIRMWARE_PATH_MT7986="mt7986-fw-20250408"

# --- [ 建议关闭的干扰项 ] ---
# CONFIG_MTK_BAND_STEERING is not set (建议在 LuCI 界面手动控制，由内核控制易断连)
# CONFIG_MTK_CON_WPS_SUPPORT is not set (WPS 有安全风险且占资源，建议设为 n)

#######################################################################
#                            PACKAGES 优化版                           #
#######################################################################

# --- [ MTK 闭源驱动配套工具 (保持 y) ] ---
CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_ucode-mod-datconf=y
CONFIG_PACKAGE_l1util=y
CONFIG_PACKAGE_ucode-mod-l1parser=y
CONFIG_PACKAGE_mii_mgr=y
CONFIG_PACKAGE_regs=y
CONFIG_PACKAGE_switch=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_mtwifi-cfg-ucode=y
CONFIG_PACKAGE_mtkhqos_util=y

# --- [ 核心功能插件 ] ---
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# --- [ 极致加速与多拨补全 (新增) ] ---
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-app-syncdial=y
CONFIG_PACKAGE_mwan3=y

# --- [ 极致瘦身：删除无 USB 冗余 (设置为 n) ] ---
# CONFIG_PACKAGE_blockd is not set
# CONFIG_PACKAGE_libblkid is not set
# CONFIG_PACKAGE_libuuid is not set
# CONFIG_PACKAGE_openssh-sftp-server is not set

# --- [ 网络与防火墙组件 ] ---
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo-ucode=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_zram-swap=y

# --- [ 游戏加速底层支持 (iptables 模块) ] ---
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-filter=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-u32=y

# --- [ 基础工具与界面 ] ---
CONFIG_PACKAGE_luci-theme-argon=y
# 既然有了 Argon，可以关掉默认的 Bootstrap 节省空间
CONFIG_PACKAGE_luci-theme-bootstrap-mod=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wireless-tools=y

# --- [ 库文件支持 (保持默认补全) ] ---
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libopenssl-afalg_sync=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_libstdcpp=y

#######################################################################
#                 MISC 优化版 (针对红米 AX6000)                      #
#######################################################################

# --- [ 核心加速修正：极致游戏体验的关键 ] ---
# 警告：你原配置中勾选了 INCLUDE_NO_FASTPATH=y，这会关闭 MTK 的硬件分载。
# 必须按以下方式修改，才能跑满千兆并降低游戏 Ping 值：
# CONFIG_PACKAGE_TURBOACC_INCLUDE_NO_FASTPATH is not set
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y

# --- [ 安全与编译优化 ] ---
CONFIG_PKG_FORTIFY_SOURCE_2=y
CONFIG_OPENSSL_WITH_NPN=y
# 开启 ChaCha 优化，对于没有 AES 硬件指令集的设备有用，AX6000 虽有 AES，但开启此项不影响
CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM=y

# --- [ SSR-Plus 插件精简：极致稳定 ] ---
# 由于 AX6000 存储有限且无 USB，建议只保留核心转发，不勾选冗余组件
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NONE_V2RAY=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
# 建议额外手动勾选 Xray，以支持目前主流的协议，在脚本中通过 make defconfig 会补全
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y

# --- [ 彻底禁用无用功能 (rclone 需要 USB，必须关闭) ] ---
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng is not set
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui is not set
